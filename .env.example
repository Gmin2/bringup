# copy to .env and fill in. .env is gitignored, .env.example is NOT.
# never put a real key in this file.

# openai. used for the gpt column in the comparison.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# quiver. https://docs.quiver.ai/api
# arrow-1.1 is the default, arrow-1.1-max is higher fidelity and costs more.
# generations are prepaid credits: 20 per generation on arrow-1.1.
QUIVER_API_KEY=
QUIVER_MODEL=arrow-1.1
QUIVER_BASE_URL=https://api.quiver.ai

# a local model, or any openai-compatible endpoint (mlx, vllm, an aggregator).
#   python -m bringup.serve --model mlx-community/Qwen3-4B-Instruct-2507-4bit
LOCAL_BASE_URL=http://localhost:8080
LOCAL_API_KEY=
LOCAL_MODEL=
LOCAL_NAME=local
# mlx defaults to 512 tokens, which truncates a drawing mid-element
LOCAL_MAX_TOKENS=16000
