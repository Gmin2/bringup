# copy to .env and fill in. .env is gitignored, never commit it.

# openai. used for the gpt column in the comparison.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# quiver. https://docs.quiver.ai/api
# arrow-1.1 is the default, arrow-1.1-max is higher fidelity and costs more credits.
QUIVER_API_KEY=
QUIVER_MODEL=arrow-1.1
QUIVER_BASE_URL=https://api.quiver.ai

# our own model, once it is being served. any openai-compatible endpoint (vllm).
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_MODEL=
